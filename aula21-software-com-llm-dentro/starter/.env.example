# Copie este arquivo pra .env (sem o .example) e preencha.
# NUNCA commite o .env. Ele já está no .gitignore — confira antes do primeiro commit.

# Chave da API da Anthropic. Pegue em https://platform.claude.com (Settings > API Keys).
# Formato real: sk-ant-api03-... (a chave completa é bem mais longa que este exemplo)
ANTHROPIC_API_KEY=sk-ant-api03-substitua-por-uma-chave-de-verdade

# Modelo usado no app principal (chamadas com streaming/tool/structured output).
# claude-sonnet-5 é o modelo confirmado na doc oficial (ver REFERENCIAS.md, item 6).
MODELO_PRINCIPAL=claude-sonnet-5

# Modelo usado nos evals em lote — mais barato, porque eval roda várias vezes.
MODELO_EVALS=claude-haiku-4-5-20251001
