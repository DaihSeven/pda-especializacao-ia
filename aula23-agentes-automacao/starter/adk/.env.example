# Copie para agente_minimo/.env (sem o .example) e preencha.
# NUNCA commite o .env de verdade. Confira starter/CHECKLIST-SEGREDOS.md da
# Semana 11 (aula21-software-com-llm-dentro/starter/CHECKLIST-SEGREDOS.md)
# antes do primeiro commit — a regra é a mesma, só muda a chave.

# Chave da API do Gemini (o ADK usa Gemini por padrão, não Claude).
# Pegue em https://aistudio.google.com/apikey — tem tier gratuito.
GOOGLE_API_KEY=substitua-por-uma-chave-de-verdade

# Se preferir usar o Vertex AI em vez do Google AI Studio (fora do escopo de
# hoje — exige projeto GCP e cobrança configurada):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=seu-projeto
# GOOGLE_CLOUD_LOCATION=us-central1

# Tracing (Lab 2 — ver starter/GUIA-TRACING.md). Plano Hobby do Langfuse,
# sem cartão: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-substitua
LANGFUSE_SECRET_KEY=sk-lf-substitua
LANGFUSE_BASE_URL=https://cloud.langfuse.com
